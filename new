<script>

(function(){

const $=(s,r=document)=>r.querySelector(s);

const esc=s=>String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

const arr=v=>Array.isArray(v)?v:[];

const STEPS=[

  {id:'login',label:'Login',sub:'Sign in'},

  {id:'jd',label:'Upload the JD',sub:'Role, skills, experience'},

  {id:'cv',label:'Upload CVs',sub:'Many at once'},

  {id:'rank',label:'Stack ranking',sub:'Score out of 100'},

  {id:'q',label:'Screening questions',sub:'10 for the call'},

  {id:'mkt',label:'Hiring market',sub:'Comparable employers'},

  {id:'ss',label:'Search strings',sub:'Naukri and LinkedIn'}

];

const S={user:null,jd:{text:'',parsed:null},cvs:[],ranking:null,q:null,mkt:null,ss:null,cur:'login'};

let pdfOk=!!window.pdfjsLib; if(pdfOk){try{pdfjsLib.GlobalWorkerOptions.workerSrc='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';}catch(e){}}



/* ---------- AI access ---------- */

const samplePromise=(window.claude&&window.claude.use)?window.claude.use('sample').catch(()=>null):Promise.resolve(null);

let ctl=null;


function demoAnalyze(prompt){
  // Offline demo mode: this produces heuristic examples locally; no CV/JD data is sent anywhere.
  const lower = prompt.toLowerCase();
  const jdText = S.jd.text || prompt;
  const skillBank = ['Python','Django','FastAPI','PostgreSQL','SQL','Kafka','Celery','Redis','AWS','Docker','CI/CD','REST APIs','JavaScript','React','Node.js','MongoDB','communication','leadership'];
  const foundSkills = skillBank.filter(x => jdText.toLowerCase().includes(x.toLowerCase()));
  if (prompt.includes('"role": string')) {
    const role = (jdText.match(/(?:senior|lead|junior|mid-level)?\s*[A-Z][A-Za-z]+(?:\s+[A-Z][A-Za-z]+){0,3}\s+(?:Engineer|Developer|Analyst|Manager|Designer)/) || [])[0] || 'Software Professional';
    const years = (jdText.match(/\b\d+\s*(?:to|-|–)\s*\d+\s*years?\b|\b\d+\+?\s*years?\b/i) || [])[0] || 'As specified in the job description';
    const loc = (jdText.match(/Location:\s*([^\n]+)/i) || [,'Not specified'])[1].trim();
    return {role,seniority:/senior|lead|principal/i.test(jdText)?'Senior':'Not specified',experience:years,location:loc,industry:/fintech|payment/i.test(jdText)?'Fintech / Payments':'Not specified',key_skills:foundSkills.slice(0,10),nice_to_have:['Problem solving','Team collaboration'].slice(0,2),summary:jdText.replace(/\s+/g,' ').slice(0,180)};
  }
  if (prompt.includes('"id": number') && prompt.includes('CVS TO SCORE:')) {
    const blocks = [...prompt.matchAll(/### CV id=(\d+) \(file: ([^)]+)\)\n([\s\S]*?)(?=\n\n### CV id=|$)/g)];
    return blocks.map(m => {
      const id=Number(m[1]), file=m[2], body=m[3], text=body.toLowerCase();
      const matched=foundSkills.filter(s=>text.includes(s.toLowerCase())).slice(0,6);
      const missing=foundSkills.filter(s=>!text.includes(s.toLowerCase())).slice(0,6);
      const score=Math.max(15,Math.min(98,Math.round(35+matched.length*8-(missing.length*2))));
      const name=(body.split(/[|\n]/)[0]||file).trim();
      const yrs=(body.match(/\b\d+\s*years?\b/i)||[])[0]||'Not clearly stated';
      return {id,name,score,years_experience:yrs,reason:`Heuristic demo score based on ${matched.length} detected relevant skills. Review the CV manually before making a decision.`,matched,missing};
    });
  }
  if (prompt.includes('"good_answer": string')) {
    const topics=(foundSkills.length?foundSkills:['role-specific technical skills','problem solving','teamwork']);
    const types=['Technical','Technical','Technical','Technical','Experience','Experience','Experience','Fit','Fit','Fit'];
    return Array.from({length:10},(_,i)=>({type:types[i],question:i<4?`Explain your practical experience with ${topics[i%topics.length]}.`:i<7?`Describe a project where you used ${topics[i%topics.length]} and explain your contribution.`:['What interests you about this role?','How do you handle changing priorities?','How do you communicate risks or delays?'][i-7],good_answer:'A strong answer gives a specific example, explains the candidate’s own actions, describes the tools or decisions used, and shares a measurable result or lesson.'}));
  }
  if (prompt.includes('"company": string')) {
    return ['Zoho','Freshworks','Accenture','TCS','Infosys','Wipro','Cognizant','Amazon'].map((company,i)=>({company,role_title:S.jd.parsed?.role||'Software Engineer',experience:S.jd.parsed?.experience||'Role dependent',compensation:['₹6–12 LPA','₹8–16 LPA','₹8–18 LPA','₹5–14 LPA','₹6–15 LPA','₹5–13 LPA','₹6–15 LPA','₹15–35 LPA'][i],location:S.jd.parsed?.location||'India'}));
  }
  if (prompt.includes('"naukri"') && prompt.includes('"linkedin"')) {
    const terms=(S.jd.parsed?.key_skills||foundSkills).slice(0,5);
    const title=S.jd.parsed?.role||'Software Engineer';
    const boolean=`("${title}" OR "Backend Engineer" OR Developer) AND (${terms.map(x=>`"${x}"`).join(' OR ')})`;
    const plain=[title,...terms].join(' ');
    return {naukri:{boolean,plain,filters:`Location: ${S.jd.parsed?.location||'Preferred location'}; experience: ${S.jd.parsed?.experience||'as required'}; notice period: filter as needed`},linkedin:{boolean,plain,filters:`Location: ${S.jd.parsed?.location||'Preferred location'}; current/past title; years of experience`}};
  }
  return {};
}

