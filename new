function errCopy(e){

  const c=e&&e.code;

  const m={unavailable:'The analysis engine is not available in this view. Open this page inside Claude to run it.',

    not_granted:'Claude access was declined. Allow it when asked, then run this step again.',

    sampling_disabled:'Claude is not enabled for this account.',

    rate_limited:'Too many requests or usage limit reached. Wait a moment and try again.',

    invalid_json:'The answer came back in an unreadable shape. Run the step again.',

    prompt_too_large:'The input is too large. Remove some CVs or shorten the JD.',

    empty_completion:'No answer came back. Run the step again.',

    refused:'The request was declined. Check the uploaded text and try again.',

    session_expired:'Your Claude session expired. Sign in again and retry.'};

