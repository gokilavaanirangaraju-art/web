async function guarded(stepId,msg,btn,fn){

  const st=$('#st-'+stepId); st.className='status';

  st.innerHTML='<span class="spin"></span><span id="stm-'+stepId+'">'+esc(msg)+'</span><button class="btn ghost small" type="button" id="stop-'+stepId+'">Stop</button>';

  st.hidden=false; if(btn) btn.disabled=true;

  $('#stop-'+stepId).onclick=()=>{ if(ctl) ctl.abort(); };

  try{ await fn(m=>{const el=$('#stm-'+stepId); if(el) el.textContent=m;}); st.hidden=true; return true; }

  catch(e){

    if(e&&e.code==='cancelled'){ st.className='status'; st.textContent='Stopped.'; }

    else { st.className='status error'; st.textContent=errCopy(e); }

    return false;

  } finally { if(btn) btn.disabled=false; }

}



/* ---------- file reading ---------- */

async function readFile(f){

  const n=f.name.toLowerCase();

  if(n.endsWith('.pdf')){

    if(!window.pdfjsLib) throw new Error('PDF reader unavailable');

    const buf=await f.arrayBuffer();

    const pdf=await pdfjsLib.getDocument({data:buf}).promise;

    let out='';

    for(let i=1;i<=pdf.numPages;i++){const pg=await pdf.getPage(i);const tc=await pg.getTextContent();out+=tc.items.map(x=>x.str).join(' ')+'\n';}

    return out.trim();

  }

  if(n.endsWith('.docx')){

    if(!window.mammoth) throw new Error('Word reader unavailable');

    const r=await mammoth.extractRawText({arrayBuffer:await f.arrayBuffer()});

    return (r.value||'').trim();

  }

  return (await f.text()).trim();

}



