<style>

/* Layout: login split screen, then a left step rail (top scroller on phones) beside one working panel per step. */

:root{

 --bg:#f1f4f3; --surface:#ffffff; --ink:#13201e; --muted:#566864; --line:#d6dfdc;

--accent:#0e6b5c; --accent-ink:#ffffff; --accent-soft:#dff0eb;
 --good:#17703a; --good-soft:#dcf1e3; --bad:#a3361f; --bad-soft:#f8e4de; --warn:#8a5a00; --warn-soft:#f7ecd0;

 --f-display:'Bricolage Grotesque','Segoe UI',system-ui,sans-serif;

--f-body:'IBM Plex Sans','Segoe UI',system-ui,sans-serif;

--f-mono:'IBM Plex Mono',ui-monospace,Consolas,monospace;

}

@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){

 --bg:#0e1514; --surface:#152120; --ink:#e5eeeb; --muted:#93a7a2; --line:#25373a;

 --accent:#43bda4; --accent-ink:#06201b; --accent-soft:#17332f;

 --good:#6fd392; --good-soft:#15301f; --bad:#f09a85; --bad-soft:#3a1f19; --warn:#e8bd62; --warn-soft:#352a10; color-scheme:dark;}}

:root[data-theme="dark"]{

--bg:#0e1514; --surface:#152120; --ink:#e5eeeb; --muted:#93a7a2; --line:#25373a;
 --accent:#43bda4; --accent-ink:#06201b; --accent-soft:#17332f;

 --good:#6fd392; --good-soft:#15301f; --bad:#f09a85; --bad-soft:#3a1f19; --warn:#e8bd62; --warn-soft:#352a10; color-scheme:dark;}



*{box-sizing:border-box}

body{background:var(--bg);color:var(--ink);font:15px/1.5 var(--f-body);padding-inline:16px;padding-block:0}

h1,h2,h3{font-family:var(--f-display);margin:0;text-wrap:balance;letter-spacing:-.01em}

button,input,textarea{font:inherit;color:inherit}

:focus-visible{outline:2px solid var(--accent);outline-offset:2px}

.mono{font-family:var(--f-mono)}

.muted{color:var(--muted)}

.btn{background:var(--accent);color:var(--accent-ink);border:0;border-radius:6px;padding:9px 16px;font-weight:600;cursor:pointer}

.btn:disabled{opacity:.5;cursor:not-allowed}

.btn.ghost{background:transparent;color:var(--ink);border:1px solid var(--line)}

.btn.small{padding:5px 10px;font-size:13px}

label.f{display:grid;gap:6px;font-weight:500;font-size:13px}

input[type=text],input[type=email],input[type=password],textarea{width:100%;background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:9px 11px}

textarea{min-height:150px;resize:vertical;line-height:1.45}



/* login */

#login{max-width:980px;margin:0 auto;min-height:100vh;display:grid;grid-template-columns:1.1fr 1fr;gap:48px;align-items:center;padding-block:32px}

#login .brand p{font-size:17px;color:var(--muted);max-width:44ch;margin:16px 0 0}

#login .brand h1{font-size:clamp(34px,5vw,52px);line-height:1.02}

.brand .tag{font:500 12px var(--f-mono);text-transform:uppercase;letter-spacing:.12em;color:var(--accent);margin-bottom:14px}

.card{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:22px}

#login form{display:grid;gap:14px}

.hint{font-size:13px;color:var(--muted)}

.err{color:var(--bad);font-size:13px}



/* app */

#app{max-width:1180px;margin:0 auto;padding-block:0 48px}

.top{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-block:14px;border-bottom:1px solid var(--line);flex-wrap:wrap}

.top .logo{font:700 20px var(--f-display)}

.top .who{display:flex;align-items:center;gap:12px;font-size:13px;color:var(--muted)}

.shell{display:grid;grid-template-columns:230px minmax(0,1fr);gap:28px;padding-top:24px}

.rail ol{list-style:none;margin:0;padding:0;display:grid;gap:4px;position:sticky;top:12px}

.rail button{width:100%;display:flex;gap:10px;align-items:center;text-align:left;background:transparent;border:1px solid transparent;border-radius:8px;padding:9px 10px;cursor:pointer;color:var(--ink)}

.rail button .n{flex:none;width:24px;height:24px;border-radius:50%;border:1px solid var(--line);display:grid;place-items:center;font:500 12px var(--f-mono);color:var(--muted)}

.rail button[aria-current=step]{background:var(--surface);border-color:var(--line);font-weight:600}

.rail button[aria-current=step] .n{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}

.rail button.done .n{background:var(--good-soft);border-color:var(--good);color:var(--good)}

.rail button:disabled{opacity:.45;cursor:not-allowed}

.rail small{display:block;color:var(--muted);font-weight:400;font-size:12px}

.panel{display:none;min-width:0}

.panel.on{display:block}

.panel>header{margin-bottom:16px}

.panel>header h2{font-size:26px}

.panel>header p{margin:6px 0 0;color:var(--muted);max-width:68ch}

.stack{display:grid;gap:16px}

.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}

.status{display:flex;align-items:center;gap:10px;padding:10px 12px;background:var(--accent-soft);border-radius:8px;font-size:14px}

.status[hidden]{display:none}

.spin{width:14px;height:14px;border:2px solid var(--accent);border-right-color:transparent;border-radius:50%;animation:sp .8s linear infinite;flex:none}

@keyframes sp{to{transform:rotate(360deg)}}

@media (prefers-reduced-motion:reduce){.spin{animation:none}}

.status.error{background:var(--bad-soft);color:var(--bad)}



.drop{display:grid;place-items:center;gap:4px;text-align:center;border:1.5px dashed var(--line);border-radius:10px;padding:26px 16px;background:var(--surface);cursor:pointer}

.drop.over{border-color:var(--accent);background:var(--accent-soft)}

.drop b{font-family:var(--f-display);font-size:17px}

.tabs{display:flex;gap:4px;border-bottom:1px solid var(--line)}

.tabs button{background:none;border:0;padding:8px 12px;cursor:pointer;color:var(--muted);border-bottom:2px solid transparent;margin-bottom:-1px}

.tabs button[aria-selected=true]{color:var(--ink);border-color:var(--accent);font-weight:600}



.kv{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:14px}

.kv div span{display:block;font:500 11px var(--f-mono);text-transform:uppercase;letter-spacing:.1em;color:var(--muted);margin-bottom:3px}

.kv div b{font-weight:600}

.chips{display:flex;flex-wrap:wrap;gap:6px}

.chip{font-size:12.5px;padding:3px 9px;border-radius:99px;background:var(--accent-soft);color:var(--ink);border:1px solid transparent}

.chip.good{background:var(--good-soft);color:var(--good)}

.chip.bad{background:var(--bad-soft);color:var(--bad)}

.chip.plain{background:transparent;border-color:var(--line);color:var(--muted)}

.sec{font:500 11px var(--f-mono);text-transform:uppercase;letter-spacing:.1em;color:var(--muted);margin:14px 0 6px}



.files{list-style:none;margin:0;padding:0;display:grid;gap:6px}

.files li{display:flex;gap:10px;align-items:center;justify-content:space-between;padding:8px 12px;border:1px solid var(--line);border-radius:8px;background:var(--surface);font-size:14px;min-width:0}

.files li span:first-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0}

.count{font:700 34px var(--f-display);line-height:1}



.rank{display:grid;gap:12px}

.cand{display:grid;grid-template-columns:44px minmax(0,1fr) 120px;gap:14px;background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:16px}

.cand .pos{font:500 13px var(--f-mono);color:var(--muted);padding-top:4px}

.cand h3{font-size:18px}

.cand .file{font:12px var(--f-mono);color:var(--muted)}

.cand p{margin:6px 0 0}

.score{text-align:right}

.score b{font:700 34px var(--f-display);line-height:1;font-variant-numeric:tabular-nums}

.score small{color:var(--muted)}

.bar{height:6px;background:var(--line);border-radius:3px;margin-top:8px;overflow:hidden}

.bar i{display:block;height:100%;background:var(--accent)}

.bar.mid i{background:var(--warn)} .bar.low i{background:var(--bad)}

.sub{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:10px}



.q{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:14px 16px;display:grid;gap:8px}

.q .qt{display:flex;gap:10px;align-items:baseline}

.q .qn{font:500 12px var(--f-mono);color:var(--muted);flex:none}

.q .qtext{font-weight:600}

.q .ga{background:var(--bg);border-radius:8px;padding:9px 12px;font-size:14px}

.q .ga b{font:500 11px var(--f-mono);text-transform:uppercase;letter-spacing:.08em;color:var(--muted);display:block;margin-bottom:2px}

.tag{font:500 11px var(--f-mono);text-transform:uppercase;letter-spacing:.06em;padding:2px 7px;border-radius:4px;flex:none}

.tag.Technical{background:var(--accent-soft);color:var(--accent)} .tag.Experience{background:var(--warn-soft);color:var(--warn)} .tag.Fit{background:var(--good-soft);color:var(--good)}



.tw{overflow-x:auto;border:1px solid var(--line);border-radius:10px;background:var(--surface)}

table{border-collapse:collapse;width:100%;min-width:640px}

th,td{text-align:left;padding:10px 14px;border-bottom:1px solid var(--line);vertical-align:top}

th{font:500 11px var(--f-mono);text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}

tr:last-child td{border-bottom:0}

.note{font-size:13px;color:var(--warn);background:var(--warn-soft);padding:9px 12px;border-radius:8px}



.ss{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}

.ss .card h3{font-size:16px;margin-bottom:2px}

.code{font:13px/1.5 var(--f-mono);background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:10px 12px;white-space:pre-wrap;word-break:break-word;margin:8px 0}



@media (max-width:820px){

  #login{grid-template-columns:1fr;gap:24px}

  .shell{grid-template-columns:minmax(0,1fr);gap:16px}

  .rail{overflow-x:auto;margin-inline:-16px;padding-inline:16px}

  .rail ol{display:flex;position:static;width:max-content}

  .rail button{width:auto;white-space:nowrap}

  .rail small{display:none}

  .cand{grid-template-columns:minmax(0,1fr) 90px}

  .cand .pos{display:none}

  .sub,.ss{grid-template-columns:minmax(0,1fr)}

}

</style>



